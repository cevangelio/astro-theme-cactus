---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About Boring Wealth Building",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			This is a journal of boring wealth building.
		</p>
		<p>
			It tracks a long-term portfolio toward financial independence. No hype, no trading signals, and no get-rich-quick plays. Just disciplined capital allocation and patience.
		</p>
		<p>The portfolio is built on three pillars:</p>
		<ul class="list-inside list-disc" role="list">
			<li>Broad-market index ETFs</li>
			<li>SRS contributions for tax advantage</li>
			<li>Selected tech equities</li>
		</ul>
		<p>
			Updated every Saturday morning with weekly numbers and portfolio tracking.
		</p>
	</div>
</PageLayout>
